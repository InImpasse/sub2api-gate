TZ=America/Los_Angeles
BIND_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
POSTGRES_DB=sub2api
REDIS_PASSWORD=replace-with-a-long-random-redis-password

ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
TOTP_ENCRYPTION_KEY=replace-with-a-long-random-totp-encryption-key

SECURITY_URL_ALLOWLIST_ENABLED=true
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=your-resource.openai.azure.com,api.openai.com
