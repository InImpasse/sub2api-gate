TZ=America/Los_Angeles
SUB2API_DATA_ROOT=/mnt/data/sub2api-gate
SUB2API_MIN_FREE_BYTES=10737418240

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
POSTGRES_DB=sub2api
SUB2API_SOURCE_DATABASE_URL=postgresql://sub2api:replace-with-legacy-postgres-password@127.0.0.1:15431/sub2api?sslmode=disable
SUB2API_TARGET_DATABASE_URL=postgresql://sub2api:replace-with-a-long-random-postgres-password@127.0.0.1:15432/sub2api?sslmode=disable
SUB2API_DATABASE_URL=postgresql://sub2api:replace-with-a-long-random-postgres-password@127.0.0.1:15432/sub2api?sslmode=disable
SUB2API_APP_DATABASE_PASSWORD=replace-with-a-distinct-long-random-app-database-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password
SUB2API_SYNC_REDIS_PASSWORD=replace-with-a-different-long-random-sync-redis-password
SUB2API_SOURCE_REDIS_URL=redis://127.0.0.1:16378/0
SUB2API_SOURCE_REDIS_USERNAME=default
SUB2API_SOURCE_REDIS_PASSWORD=replace-with-the-legacy-source-redis-password
SUB2API_TARGET_REDIS_URL=redis://127.0.0.1:16379/0
SUB2API_TARGET_REDIS_USERNAME=sub2api_migration
SUB2API_TARGET_REDIS_PASSWORD=replace-with-a-one-time-random-redis-migration-password
SUB2API_SYNC_DATABASE_PASSWORD=replace-with-a-different-long-random-database-password
SUB2API_SYNC_SECRET=replace-with-at-least-32-random-characters
SUB2API_LOGIN_URL=https://api.example.com
SUB2API_PUBLIC_BASE_URL=https://api.example.com/v1

JWT_SECRET=replace-with-a-long-random-jwt-secret
TOTP_ENCRYPTION_KEY=replace-with-a-long-random-totp-encryption-key

SECURITY_URL_ALLOWLIST_ENABLED=true
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=your-resource.openai.azure.com,api.openai.com
